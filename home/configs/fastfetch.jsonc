{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
	"modules":	[
		"title",
		"separator",
		"os",
		"kernel",
		"packages",
		"uptime",
		{
			"type": "command",
			"key": "Age",
			"text": "echo $(( ( $(date +%s) - $(stat -c %W /) ) / 86400 )) days",
			"format": "{result}"
		},
		"separator",
		"wm",
		"wmtheme",
		"theme",
		"icons",
		"font",
		"cursor",
		"terminal",
		"terminalfont",
		"separator",
		"host",
		"cpu",
		"gpu",
		"memory",
		"swap",
		"disk",
		"break",
		"colors"
	]
}
